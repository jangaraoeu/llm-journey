#!/usr/bin/env python3
"""lj — daily LLM learning journal: log, recall, review, export.

Usage:
  lj [today]            create/open today's log in $EDITOR
  lj recall             quiz yourself on the previous log (after writing your Recall section)
  lj review [-n N]      spaced-repetition review of due cards (SM-2)
  lj cards              list every card and when it's due
  lj export [--anki]    write anki/cards.tsv (or push to Anki via AnkiConnect)
  lj paper "Title"      create a paper note in papers/
  lj build <name>       create builds/<date>-<name>/ for today's code
  lj status [--json]    streak, due cards, whether today is logged
"""
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.request
from pathlib import Path

ROOT = Path(os.environ.get("LJ_HOME") or Path(__file__).resolve().parent.parent)
DAYS = ROOT / "days"
PAPERS = ROOT / "papers"
BUILDS = ROOT / "builds"
STATE = ROOT / "srs" / "state.json"
TEMPLATES = ROOT / "templates"

CARD_RE = re.compile(r"^\s*[-*]\s+(.+?)\s+::\s+(.+?)\s*$")
COMMENT_RE = re.compile(r"<!--.*?-->", re.S)
FRONTMATTER_RE = re.compile(r"\A---\n.*?\n---\n", re.S)


def today():
    return dt.date.today()


def day_path(d):
    return DAYS / f"{d:%Y}" / f"{d:%Y-%m-%d}.md"


def day_files():
    return sorted(DAYS.glob("*/*.md"))


def file_date(p):
    return dt.date.fromisoformat(p.stem)


def strip_noise(text):
    return COMMENT_RE.sub("", FRONTMATTER_RE.sub("", text))


def is_logged(p):
    """A day counts once something beyond the template headings is written."""
    if not p.exists():
        return False
    body = [l for l in strip_noise(p.read_text()).splitlines()
            if l.strip() and not l.lstrip().startswith("#")]
    return bool(body)


def section(text, name):
    m = re.search(rf"^## {re.escape(name)}.*?\n(.*?)(?=^## |\Z)", strip_noise(text), re.S | re.M)
    return m.group(1).strip() if m else ""


def editor(path):
    ed = os.environ.get("EDITOR", "nvim")
    subprocess.call([*ed.split(), str(path)])


def refresh_widget():
    subprocess.run(["omarchy-shell", "jangar.llm-journey", "refresh"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


# ---------- cards / SRS ----------

def card_id(q):
    return hashlib.sha1(" ".join(q.lower().split()).encode()).hexdigest()[:12]


def collect_cards():
    cards = {}
    for p in [*day_files(), *sorted(PAPERS.glob("*.md"))]:
        for line in strip_noise(p.read_text()).splitlines():
            m = CARD_RE.match(line)
            if m:
                q, a = m.groups()
                cards[card_id(q)] = {"q": q, "a": a, "src": str(p.relative_to(ROOT))}
    return cards


def load_state():
    return json.loads(STATE.read_text()) if STATE.exists() else {}


def save_state(state):
    STATE.parent.mkdir(exist_ok=True)
    STATE.write_text(json.dumps(state, indent=1, sort_keys=True) + "\n")


def due_cards(cards, state):
    t = today().isoformat()
    return [cid for cid in cards if state.get(cid, {}).get("due", "") <= t]


def sm2(s, grade):
    """grade: 1 again, 2 hard, 3 good, 4 easy."""
    ease, interval, reps = s.get("ease", 2.5), s.get("interval", 0), s.get("reps", 0)
    if grade == 1:
        reps, interval = 0, 1
    else:
        reps += 1
        interval = 1 if reps == 1 else 3 if reps == 2 else round(interval * ease * (1.2 if grade == 4 else 1))
        if grade == 2:
            interval = max(1, round(interval * 0.6))
    q = {1: 1, 2: 3, 3: 4, 4: 5}[grade]
    ease = max(1.3, ease + 0.1 - (5 - q) * (0.08 + (5 - q) * 0.02))
    due = today() + dt.timedelta(days=interval)
    return {"ease": round(ease, 3), "interval": interval, "reps": reps, "due": due.isoformat()}


# ---------- commands ----------

def cmd_today(_):
    d = today()
    p = day_path(d)
    if not p.exists():
        prev = [f for f in day_files() if file_date(f) < d]
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text((TEMPLATES / "day.md").read_text().format(
            date=d.isoformat(), day=len(day_files()) + 1,
            prev=prev[-1].stem if prev else "nothing yet — day one!"))
        print(f"created {p.relative_to(ROOT)}")
    editor(p)
    refresh_widget()


def cmd_recall(_):
    prev = [f for f in day_files() if file_date(f) < today() and is_logged(f)]
    if not prev:
        return print("No previous log to recall yet.")
    p = prev[-1]
    text = p.read_text()
    cards = [CARD_RE.match(l).groups() for l in strip_noise(text).splitlines() if CARD_RE.match(l)]
    print(f"\n\033[1mRecall check — {p.stem}\033[0m\n")
    for i, (q, a) in enumerate(cards, 1):
        input(f"  {i}. {q}  \033[2m[enter]\033[0m")
        print(f"     → {a}\n")
    input("\033[2mEnter to reveal yesterday's takeaways…\033[0m")
    print("\n" + (section(text, "Takeaways") or "(no takeaways written)"))
    tmw = section(text, "Tomorrow")
    if tmw:
        print(f"\n\033[1mYou planned:\033[0m\n{tmw}")


def cmd_review(args):
    limit = int(args[args.index("-n") + 1]) if "-n" in args else 50
    cards, state = collect_cards(), load_state()
    due = sorted(due_cards(cards, state), key=lambda c: state.get(c, {}).get("due", ""))[:limit]
    if not due:
        return print("Nothing due. 🎉")
    print(f"{len(due)} card(s) due. Grades: 1 again · 2 hard · 3 good · 4 easy · q quit\n")
    done = 0
    for cid in due:
        c = cards[cid]
        input(f"\033[1mQ:\033[0m {c['q']}  \033[2m({c['src']})\033[0m ")
        print(f"\033[32mA:\033[0m {c['a']}")
        g = ""
        while g not in ("1", "2", "3", "4", "q"):
            g = input("grade> ").strip().lower()
        if g == "q":
            break
        state[cid] = sm2(state.get(cid, {}), int(g))
        save_state(state)
        done += 1
        print()
    print(f"Reviewed {done}. {len(due_cards(cards, state))} still due.")
    refresh_widget()


def cmd_cards(_):
    cards, state = collect_cards(), load_state()
    for cid, c in cards.items():
        print(f"{state.get(cid, {}).get('due', 'new'):>10}  {c['q']}  \033[2m{c['src']}\033[0m")
    print(f"\n{len(cards)} cards, {len(due_cards(cards, state))} due")


def cmd_export(args):
    cards = collect_cards()
    if "--anki" in args:
        notes = [{"deckName": "LLM Journey", "modelName": "Basic",
                  "fields": {"Front": c["q"], "Back": f"{c['a']}<br><small>{c['src']}</small>"},
                  "tags": ["llm-journey", Path(c["src"]).stem], "options": {"allowDuplicate": False}}
                 for c in cards.values()]
        def anki(action, **params):
            req = json.dumps({"action": action, "version": 6, "params": params}).encode()
            return json.load(urllib.request.urlopen("http://127.0.0.1:8765", req))
        try:
            anki("createDeck", deck="LLM Journey")
            ok = anki("canAddNotes", notes=notes)["result"]
            res = anki("addNotes", notes=[n for n, k in zip(notes, ok) if k])
        except OSError:
            sys.exit("AnkiConnect not reachable on :8765 — is Anki running with the AnkiConnect add-on?")
        return print(f"Added {sum(1 for r in res['result'] or [] if r)} new note(s) to Anki.")
    out = ROOT / "anki" / "cards.tsv"
    out.parent.mkdir(exist_ok=True)
    with out.open("w") as f:
        f.write("#separator:tab\n#html:true\n#deck:LLM Journey\n#tags column:3\n")
        for c in cards.values():
            f.write(f"{c['q']}\t{c['a']}\tllm-journey {Path(c['src']).stem}\n")
    print(f"Wrote {len(cards)} cards → {out.relative_to(ROOT)}  (Anki: File → Import)")


def slug(s):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:60]


def cmd_paper(args):
    if not args:
        sys.exit('usage: lj paper "Attention Is All You Need"')
    title = " ".join(args)
    p = PAPERS / f"{slug(title)}.md"
    if not p.exists():
        p.write_text((TEMPLATES / "paper.md").read_text().format(title=title, date=today().isoformat()))
    editor(p)


def cmd_build(args):
    if not args:
        sys.exit("usage: lj build <name>")
    d = BUILDS / f"{today():%Y-%m-%d}-{slug(' '.join(args))}"
    d.mkdir(parents=True, exist_ok=True)
    readme = d / "README.md"
    if not readme.exists():
        readme.write_text(f"# {' '.join(args)}\n\nGoal:\n\nWhat worked:\n\nWhat broke:\n")
    print(d)


def status():
    logged = sorted({file_date(f) for f in day_files() if is_logged(f)})
    t = today()
    streak, d = 0, t if t in logged else t - dt.timedelta(days=1)
    while d in logged:
        streak, d = streak + 1, d - dt.timedelta(days=1)
    cards, state = collect_cards(), load_state()
    return {"streak": streak, "loggedToday": t in logged, "days": len(logged),
            "cards": len(cards), "due": len(due_cards(cards, state))}


def cmd_status(args):
    s = status()
    if "--json" in args:
        return print(json.dumps(s))
    print(f"🔥 streak {s['streak']} · {s['days']} days logged · "
          f"{s['due']}/{s['cards']} cards due · today {'✓' if s['loggedToday'] else '✗ not logged'}")


COMMANDS = {"today": cmd_today, "recall": cmd_recall, "review": cmd_review, "cards": cmd_cards,
            "export": cmd_export, "paper": cmd_paper, "build": cmd_build, "status": cmd_status}

if __name__ == "__main__":
    argv = sys.argv[1:] or ["today"]
    if argv[0] in ("-h", "--help", "help") or argv[0] not in COMMANDS:
        sys.exit(__doc__)
    try:
        COMMANDS[argv[0]](argv[1:])
    except (KeyboardInterrupt, EOFError):
        print()
